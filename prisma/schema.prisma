generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(uuid())
  phone            String        @unique
  name             String
  currency         String        @default("BRL")
  dailySummaryTime String        @default("20:00")
  alertThreshold   Decimal       @default(100) @db.Decimal(10, 2)
  createdAt        DateTime      @default(now())
  transactions     Transaction[]
  installments     Installment[]
  goals            Goal[]
  investments      Investment[]
  budgets          Budget[]
}

model Category {
  id           String        @id @default(uuid())
  name         String        @unique
  color        String        @default("#64748b")
  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id            String       @id @default(uuid())
  userId        String
  categoryId    String?
  amount        Decimal      @db.Decimal(10, 2)
  description   String
  date          DateTime     @default(now())
  type          String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?    @relation(fields: [categoryId], references: [id])
  installmentId String?
  installment   Installment? @relation(fields: [installmentId], references: [id])

  @@index([userId])
}

model Installment {
  id            String        @id @default(uuid())
  userId        String
  description   String
  totalAmount   Decimal       @db.Decimal(10, 2)
  totalParcels  Int
  currentParcel Int           @default(1)
  dueDay        Int
  startDate     DateTime
  endDate       DateTime
  isCompleted   Boolean       @default(false)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@index([userId])
}

model Goal {
  id           String   @id @default(uuid())
  userId       String
  name         String
  category     String?
  targetAmount Decimal  @db.Decimal(10, 2)
  savedAmount  Decimal  @default(0) @db.Decimal(10, 2)
  deadline     DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Investment {
  id           String    @id @default(uuid())
  userId       String
  type         String
  name         String
  amount       Decimal   @db.Decimal(10, 2)
  yieldRate    Decimal?  @db.Decimal(5, 4)
  maturityDate DateTime?
  lastUpdate   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  monthLimit Decimal  @db.Decimal(10, 2)
  rollover   Boolean  @default(false)
  month      String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month])
  @@index([userId])
}
